{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_audit_log' %}

{% block main %}
    <h1>Audit log</h1>

    <table class="table table-striped table-borderless">
        <thead>
            <tr>
                <th scope="col">Date (UTC)</th>
                <th scope="col">Admin</th>
                <th scope="col">Action</th>
                <th scope="col">Post</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in entries %}
                <tr>
                    <td>{{ entry.date }}</td>
                    <td>{{ entry.admin }}</td>
                    <td>{{ entry.action }}</td>
                    <td>{{ entry.post }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-center">No admin action recorded yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block sidebar %}{% endblock %}
