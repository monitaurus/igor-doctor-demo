{#
    This is the base template used as the application layout which contains the
    common elements and decorates all the other templates.
    See https://symfony.com/doc/current/templates.html#template-inheritance-and-layouts
#}
<!DOCTYPE html>
<html lang="{{ app.locale }}" dir="{{ is_rtl() ? 'rtl' : 'ltr' }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="view-transition" content="same-origin">
        <title>{% block title %}Leaky Blog{% endblock %}</title>
        <link rel="alternate" type="application/rss+xml" title="{{ 'rss.title'|trans }}" href="{{ path('blog_rss') }}">
        <link rel="shortcut icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">

        {#
            Those two blocks defines frontend entrypoint for CSS and JavaScript assets
            See https://symfony.com/doc/current/frontend.html
        #}
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# When using FrankenPHP to serve your application, this feature
           automatically reloads the current page whenever you modify a file #}
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    <body id="{% block body_id %}{% endblock %}" class="{{ is_rtl(app.locale) ? 'rtl' }}">

        {% block header %}
            {% set _route = app.current_route %}
            <header>
                <nav class="navbar navbar-expand-lg fixed-top navbar-dark bg-primary">
                    <div class="container">
                        <a class="navbar-brand" href="{{ path('homepage') }}">
                            Leaky Blog
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appNavbar" aria-controls="appNavbar" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="appNavbar">
                            <ul class="navbar-nav">
                                {% block header_navigation_links %}
                                    <li class="nav-item">
                                        <a class="nav-link {{ _route == 'blog_index' ? 'active' }}" href="{{ path('blog_index') }}">
                                            <twig:ux:icon name="tabler:home"/> {{ 'menu.homepage'|trans }}
                                        </a>
                                    </li>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <li class="nav-item">
                                            <a class="nav-link" href="{{ path('admin_post_index') }}">
                                                <twig:ux:icon name="tabler:lock"/> {{ 'menu.admin'|trans }}
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endblock %}

                                <li class="nav-item">
                                    <a class="nav-link {{ _route == 'blog_search' ? 'active' }}" href="{{ path('blog_search') }}">
                                        <twig:ux:icon name="tabler:search"/> {{ 'menu.search'|trans }}
                                    </a>
                                </li>

                                {% if app.user %}
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <twig:ux:icon name="tabler:user"/> {{ app.user.fullname }}
                                        </a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="{{ path('user_edit') }}">
                                                <twig:ux:icon name="tabler:id-badge-2"/> {{ 'menu.user'|trans }}
                                            </a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="{{ logout_path() }}">
                                                <twig:ux:icon name="tabler:logout"/> {{ 'menu.logout'|trans }}
                                            </a></li>
                                        </ul>
                                    </li>
                                {% endif %}

                                <li class="nav-item">
                                    {% from 'default/_language_selector.html.twig' import render_language_selector %}
                                    {{ render_language_selector() }}
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
        {% endblock %}

        <div class="container body-container">
            {% block breadcrumbs %}
                {% if breadcrumbs() is not empty %}
                    <nav aria-label="breadcrumb" id="breadcrumbs">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="{{ path('blog_index') }}">{{ 'menu.homepage'|trans }}</a></li>
                            {% for crumb in breadcrumbs() %}
                                <li class="breadcrumb-item {{ loop.last ? 'active' }}" {{ loop.last ? 'aria-current="page"' }}>
                                    {% if crumb.url and not loop.last %}<a href="{{ crumb.url }}">{{ crumb.label }}</a>{% else %}{{ crumb.label }}{% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    </nav>
                {% endif %}
            {% endblock %}
            {% block body %}
                <div class="row">
                    <div id="main" class="col-sm-9">
                        {{ include('default/_flash_messages.html.twig') }}

                        {% block main %}{% endblock %}
                    </div>

                    <div id="sidebar" class="col-sm-3">
                        {% block sidebar %}
                            {{ render_esi(controller('Symfony\\Bundle\\FrameworkBundle\\Controller\\TemplateController::templateAction', {
                                template: 'blog/about.html.twig',
                                sharedAge: 600,
                                _locale: app.locale,
                            })) }}
                        {% endblock %}
                    </div>
                </div>
            {% endblock %}
        </div>

        {% block footer %}
            <footer>
                <div class="container">
                    <div class="row">
                        <div id="footer-copyright" class="col-md-4">
                            <p>&copy; {{ 'now'|date('Y') }} - The Symfony Project</p>
                            <p>{{ 'mit_license'|trans }}</p>
                        </div>
                        <div id="footer-timezone" class="col-md-4">
                            <form method="get" class="d-flex align-items-center gap-2">
                                <label for="display-tz" class="text-nowrap">Show dates in</label>
                                <select id="display-tz" name="tz" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                                    {% for timezone in display_timezone_choices() %}
                                        <option value="{{ timezone }}" {{ timezone == display_timezone() ? 'selected' }}>{{ timezone }}</option>
                                    {% endfor %}
                                </select>
                            </form>
                        </div>
                        <div id="footer-resources" class="col-md-4">
                            <p>
                                <a rel="noopener noreferrer" target="_blank" href="https://twitter.com/symfony" title="Symfony on X (formerly Twitter)">
                                    <twig:ux:icon name="tabler:brand-x" font-size="28px" /> <span class="sr-only">X/Twitter</span>
                                </a>
                                <a target="_blank" href="https://symfony.com/blog/" title="Symfony Blog">
                                    <twig:ux:icon name="tabler:rss" font-size="28px" /> <span class="sr-only">RSS feed</span>
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
            </footer>
        {% endblock %}

        {#
            It's not mandatory to set the timezone in format_datetime(). This is done to
            avoid errors when the 'intl' PHP extension is not available and the application
            is forced to use the limited "intl polyfill", which only supports UTC and GMT
        #}
        {# Leaky Blog: how this page was served. In worker mode the boot id stays the same until the worker restarts. #}
        <div id="runtime-badge" class="badge {{ runtime_mode() == 'worker' ? 'text-bg-danger' : 'text-bg-secondary' }}"
             style="position: fixed; bottom: 48px; right: 12px; z-index: 1080; font-size: .85rem;">
            {{ runtime_mode()|upper }} mode &middot; boot {{ boot_id() }}
        </div>

        <!-- Page rendered on {{ 'now'|format_datetime('long', 'long', '', 'UTC') }} -->
    </body>
</html>
